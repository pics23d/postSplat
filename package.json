{
    "name": "postsplat",
    "version": "0.1.0",
    "author": "Guy Middleton",
    "description": "postSplat - Windows desktop editor for cleaning 3D Gaussian Splats. Unofficial fork of PlayCanvas SuperSplat.",
    "keywords": [
        "playcanvas",
        "ply",
        "gaussian",
        "splat",
        "editor"
    ],
    "license": "MIT",
    "main": "electron/dist/main.js",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "serve": "serve dist -C",
        "develop": "cross-env BUILD_TYPE=debug concurrently --kill-others \"npm run watch\" \"npm run serve\"",
        "develop:auto-launch": "concurrently --kill-others \"xdg-open 'http://localhost:3000/'\" \"npm run watch\" \"npm run serve\"",
        "lint": "eslint src",
        "lint:locales": "node scripts/check-locales.mjs",
        "test": "node --import tsx --test \"test/**/*.test.ts\"",
        "desktop:main": "tsc -p electron/tsconfig.json",
        "desktop:build": "cross-env BUILD_TYPE=debug rollup -c && npm run desktop:main",
        "desktop:start": "node scripts/desktop-start.mjs",
        "desktop:dev": "npm run desktop:build && npm run desktop:start",
        "desktop:pack": "rollup -c && npm run desktop:main && electron-builder --win"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "2.1.0",
        "@playcanvas/splat-transform": "3.4.2",
        "@playcanvas/pcui": "6.1.4",
        "@rollup/plugin-alias": "6.0.0",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/node": "^26.4.1",
        "@types/wicg-file-system-access": "2023.10.7",
        "@typescript-eslint/eslint-plugin": "8.70.0",
        "@typescript-eslint/parser": "8.70.0",
        "@webgpu/types": "0.1.72",
        "autoprefixer": "10.5.5",
        "concurrently": "10.0.5",
        "cross-env": "10.1.0",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "eslint": "10.10.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "globals": "17.12.0",
        "i18next": "26.4.2",
        "i18next-browser-languagedetector": "8.2.1",
        "i18next-http-backend": "4.0.2",
        "mediabunny": "1.56.0",
        "playcanvas": "2.22.1",
        "postcss": "8.5.28",
        "rollup": "4.63.1",
        "rollup-plugin-scss": "4.0.1",
        "sass": "1.104.0",
        "serve": "14.2.6",
        "tslib": "2.8.1",
        "tsx": "^4.23.13",
        "typescript": "6.0.3"
    }
}
